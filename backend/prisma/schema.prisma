generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                     String             @id @default(uuid())
  email                  String             @unique
  password               String
  nombre                 String
  apellido               String
  rol                    Rol
  activo                 Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  depositoId             String?
  creadoPorId            String?
  fotoUrl                String?            @default("https://ui-avatars.com/api/?background=random&color=fff&name=User")
  codigoVerificacion     String?
  verificado             Boolean            @default(true)
  tokenSesion            String?
  solicitudesAprobadas   SolicitudEdicion[] @relation("UsuarioAprobador")
  solicitudesCompletadas SolicitudEdicion[] @relation("UsuarioCompletador")
  solicitudesResueltas   SolicitudEdicion[] @relation("UsuarioResolutor")
  solicitudesCreadas     SolicitudEdicion[] @relation("UsuarioSolicitante")
  creadoPor              Usuario?           @relation("UsuarioCreador", fields: [creadoPorId], references: [id])
  usuariosCreados        Usuario[]          @relation("UsuarioCreador")
  deposito               Deposito?          @relation(fields: [depositoId], references: [id])
  vehiculos              Vehiculo[]

  @@map("usuarios")
}

model Deposito {
  id                  String     @id @default(uuid())
  nombre              String
  municipio           String
  direccion           String
  capacidad           Int
  telefono            String
  nombrePropietario   String
  rfc                 String
  telefonoPropietario String
  activo              Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  usuarios            Usuario[]
  vehiculos           Vehiculo[]

  @@map("depositos")
}

model Vehiculo {
  id                        String             @id @default(uuid())
  folioProceso              String             @unique
  fechaIngreso              DateTime           @default(now())
  autoridad                 String
  documentosAdjuntos        String[]
  noInventario              String             @unique
  marcaTipo                 String
  anio                      Int
  tipoServicio              TipoServicio
  vin                       String             @unique
  placa                     String             @unique
  noMotor                   String
  colorOriginal             String
  colorActual               String
  odometro                  Int
  estatusLegal              EstatusLegal
  tieneActaBaja             Boolean            @default(false)
  noOficio                  String?
  fechaActaBaja             DateTime?
  tieneTituloFactura        Boolean            @default(false)
  estadoCarroceria          String?
  estadoCristales           String?
  estadoEspejos             String?
  estadoLlantasDelanteras   String?
  estadoLlantasTraseras     String?
  motorCompleto             Boolean?
  bateriaPresente           Boolean?
  tipoTransmision           TipoTransmision?
  estadoAsientos            String?
  estadoCinturones          String?
  estadoVolanteTablero      String?
  estadoFrenos              String?
  aireAcondicionadoFunciona Boolean?
  liquidosDrenados          Boolean            @default(false)
  estadoBolsasAire          String?
  observacionesInspector    String?
  activo                    Boolean            @default(true)
  fechaSalida               DateTime?
  justificacionBaja         String?
  documentoPdfUrl           String?
  depositoId                String
  registradoPorId           String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  fotos                     String[]
  cantAceite                String?
  cantAnticongelante        String?
  cantCombustible           String?
  estatusAceite             String?
  estatusAnticongelante     String?
  estatusCombustible        String?
  objetosPersonales         String[]
  solicitudesEdicion        SolicitudEdicion[]
  deposito                  Deposito           @relation(fields: [depositoId], references: [id])
  registradoPor             Usuario?           @relation(fields: [registradoPorId], references: [id])

  @@map("vehiculos")
}

model SolicitudEdicion {
  id                String           @id @default(uuid())
  motivo            String
  fechaSolicitud    DateTime         @default(now())
  fechaResolucion   DateTime?
  vehiculoId        String
  solicitanteId     String?
  resolutorId       String?
  camposIncorrectos String[]
  estatus           EstatusSolicitud @default(PENDIENTE)
  aprobadoPorId     String?
  completadoPorId   String?
  aprobadoPor       Usuario?         @relation("UsuarioAprobador", fields: [aprobadoPorId], references: [id])
  completadoPor     Usuario?         @relation("UsuarioCompletador", fields: [completadoPorId], references: [id])
  resolutor         Usuario?         @relation("UsuarioResolutor", fields: [resolutorId], references: [id])
  solicitante       Usuario?         @relation("UsuarioSolicitante", fields: [solicitanteId], references: [id])
  vehiculo          Vehiculo         @relation(fields: [vehiculoId], references: [id])

  @@map("solicitudes_edicion")
}

enum Rol {
  SUPER_USUARIO
  ADMINISTRADOR
  ADMINISTRADOR_CONCESIONARIO
}

enum EstatusSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
  COMPLETADA
}

enum EstatusLegal {
  ROBADO
  DECOMISADO
  OBSOLETO
  SINIESTRADO
}

enum TipoServicio {
  PARTICULAR
  PUBLICO
}

enum TipoTransmision {
  MANUAL
  AUTOMATICA
}
